name: Deploy to exe.dev
on:
  push:
    branches: [main]

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Deploy via SSH
        uses: appleboy/ssh-action@v1
        with:
          host: ${{ vars.EXE_DEV_HOST }}
          username: ${{ vars.EXE_DEV_USER }}
          key: ${{ secrets.EXE_DEV_SSH_KEY }}
          script: |
            cd ~/claude-cron && git pull --ff-only
            claude -p --dangerously-skip-permissions /deploy
